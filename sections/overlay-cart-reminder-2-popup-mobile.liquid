{%- liquid
  assign popup_enabled = section.settings.enabled
  assign excluded_pages_json = section.settings.excluded_pages | newline_to_br | split: '<br />' | json
  assign klaviyo_replaces_content = false
  if section.settings.klaviyo_replace_content and section.settings.klaviyo_form_id != blank
    assign klaviyo_replaces_content = true
  endif
-%}

{{ 'overlay-cart-reminder-2-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'overlay-cart-reminder-popup.js' | asset_url }}" defer="defer"></script>

<cart-reminder-popup
  id="CartReminderPopup2Mobile-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-device-target="mobile"
  data-enabled="{% if popup_enabled %}true{% else %}false{% endif %}"
  data-force-show="{% if section.settings.force_show %}true{% else %}false{% endif %}"
  data-cart-count="{{ cart.item_count }}"
  data-return-delay="{{ section.settings.return_delay }}"
  data-inactivity-time="{{ section.settings.inactivity_time }}"
  data-browse-auto-show-time="{{ section.settings.browse_auto_show_time }}"
  data-browse-auto-show-after-cart-time="{{ section.settings.browse_auto_show_after_cart_time }}"
  data-cart-page-auto-show-time="120"
  data-frequency-cap="{{ section.settings.frequency_cap }}"
  data-frequency-cap-seconds="{{ section.settings.frequency_cap_seconds }}"
  data-disable-homepage="{% if section.settings.disable_homepage %}true{% else %}false{% endif %}"
  data-excluded-pages='{{ excluded_pages_json }}'
  data-page-type="{{ template.name }}"
  data-current-path="{{ request.path }}"
  data-storage-key="cart-reminder-popup"
  data-show-email-field="false"
  data-use-klaviyo-embed="{% if section.settings.klaviyo_form_id != blank %}true{% else %}false{% endif %}"
  data-klaviyo-replaces-content="{% if klaviyo_replaces_content %}true{% else %}false{% endif %}"
  data-klaviyo-form-id="{{ section.settings.klaviyo_form_id | escape }}"
  data-klaviyo-list-id="{{ section.settings.klaviyo_list_id | escape }}"
  data-klaviyo-list-id-mobile="{{ section.settings.klaviyo_list_id_mobile | escape }}"
  data-klaviyo-company-id="{{ section.settings.klaviyo_company_id | escape }}"
  data-order-completed-key="cart-reminder-order-completed"
  data-order-suppression-days="{{ section.settings.order_suppression_days }}"
  data-once-per-session="{% if section.settings.once_per_session %}true{% else %}false{% endif %}"
  data-max-cart-items="{{ section.settings.max_cart_items }}"
  data-countdown-minutes="{{ section.settings.countdown_minutes }}"
  data-promo-code-filled="{{ section.settings.promo_code_filled | default: 'MERRY25' | escape }}"
  data-promo-code-empty="{{ section.settings.promo_code_empty | default: 'XMAS25' | escape }}"
>
  <div
    class="cart-reminder-popup cart-reminder-popup--v2 cart-reminder-popup--mobile{% if request.design_mode %} is-open{% endif %}"
    aria-hidden="{% if request.design_mode %}false{% else %}true{% endif %}"
  >
    <div class="cart-reminder-popup__overlay"></div>

    <div
      class="cart-reminder-popup__dialog color-{{ section.settings.color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ section.settings.heading | escape }}"
    >
      <button
        type="button"
        class="cart-reminder-popup__close"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>

      <div class="cart-reminder-popup__content{% if klaviyo_replaces_content %} cart-reminder-popup__content--klaviyo{% endif %}">
        {%- if section.settings.heading != blank or section.settings.heading_sub != blank -%}
          <h2 class="cart-reminder-popup__heading" data-cart-filled-only{% if cart.item_count == 0 %} hidden{% endif %}>
            {%- if section.settings.heading != blank -%}
              <span class="cart-reminder-popup__heading-line">{{ section.settings.heading | escape }}</span>
            {%- endif -%}
            {%- if section.settings.heading_sub != blank -%}
              <span class="cart-reminder-popup__heading-sub">{{ section.settings.heading_sub | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.empty_heading != blank or section.settings.empty_heading_sub != blank -%}
          <h2 class="cart-reminder-popup__heading" data-cart-empty-only{% if cart.item_count > 0 %} hidden{% endif %}>
            {%- if section.settings.empty_heading != blank -%}
              <span class="cart-reminder-popup__heading-line">{{ section.settings.empty_heading | escape }}</span>
            {%- endif -%}
            {%- if section.settings.empty_heading_sub != blank -%}
              <span class="cart-reminder-popup__heading-sub">{{ section.settings.empty_heading_sub | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        <div class="cart-reminder-popup__promo" aria-live="polite">
          <span class="cart-reminder-popup__promo-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.6"/>
              <path d="M12 8v4.2l2.6 1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <div class="cart-reminder-popup__promo-copy">
            {%- if section.settings.timer_label != blank -%}
              <p class="cart-reminder-popup__promo-title">{{ section.settings.timer_label | escape }}</p>
            {%- endif -%}
            <p class="cart-reminder-popup__promo-expires">
              {%- if section.settings.expires_label != blank -%}
                {{ section.settings.expires_label | escape }}&nbsp;
              {%- endif -%}
              <span class="cart-reminder-popup__countdown-time" data-cart-reminder-countdown>00:05:00</span>
            </p>
          </div>
        </div>

        {% render 'cart-reminder-popup-items', max_items: section.settings.max_cart_items %}

        {%- if klaviyo_replaces_content -%}
          <div
            class="cart-reminder-popup__klaviyo-embed cart-reminder-popup__klaviyo-embed--replaces-email"
            data-klaviyo-embed-slot
          >
            <div class="klaviyo-form-{{ section.settings.klaviyo_form_id }}"></div>
            <div
              class="cart-reminder-popup__klaviyo-fallback"
              data-klaviyo-fallback
              hidden
            >
              <input
                class="cart-reminder-popup__email-input"
                type="email"
                name="email"
                autocomplete="email"
                inputmode="email"
                placeholder="{{ section.settings.email_placeholder | default: 'Enter your email' | escape }}"
              >
              {%- if section.settings.button_label != blank -%}
                <button
                  type="button"
                  class="cart-reminder-popup__button button button--primary"
                  data-cart-reminder-submit
                >
                  <span class="cart-reminder-popup__button-label">{{ section.settings.button_label | escape }}</span>
                </button>
              {%- endif -%}
            </div>
          </div>
          {%- comment -%} Klaviyo form already has Maybe Later — do not render a second theme dismiss. {%- endcomment -%}
        {%- else -%}
          {%- if section.settings.klaviyo_form_id != blank -%}
            <div class="cart-reminder-popup__klaviyo-embed" data-klaviyo-embed-slot>
              <div class="klaviyo-form-{{ section.settings.klaviyo_form_id }}"></div>
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <button
              type="button"
              class="cart-reminder-popup__button button button--primary"
              data-cart-reminder-submit
            >
              <span class="cart-reminder-popup__button-label">{{ section.settings.button_label | escape }}</span>
              <span class="cart-reminder-popup__button-loading" hidden aria-hidden="true">...</span>
            </button>
          {%- endif -%}

          {%- if section.settings.dismiss_label != blank -%}
            <button type="button" class="cart-reminder-popup__dismiss" data-cart-reminder-dismiss>
              {{ section.settings.dismiss_label | escape }}
            </button>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</cart-reminder-popup>

{% schema %}
{
  "name": "Cart reminder 2 (mobile)",
  "tag": "section",
  "class": "overlay-section overlay-section--cart-reminder-2-mobile",
  "limit": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Cart reminder 2 (mobile)",
      "default": false,
      "info": "Same show rules as Cart reminder. Prefer enabling only one cart-reminder design at a time."
    },
    {
      "type": "checkbox",
      "id": "force_show",
      "label": "Force show (preview / QA)",
      "default": false,
      "info": "Ignores timing/frequency so you can preview in the editor or on DEV. Turn off before LIVE."
    },
    {
      "type": "header",
      "content": "Timing"
    },
    {
      "type": "paragraph",
      "content": "Same trigger timing fields as Cart reminder (return visit, inactivity, browse, after ATC, frequency)."
    },
    {
      "type": "range",
      "id": "return_delay",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "sec",
      "label": "Return visit delay",
      "default": 15
    },
    {
      "type": "range",
      "id": "inactivity_time",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "sec",
      "label": "Inactivity time",
      "default": 20
    },
    {
      "type": "range",
      "id": "browse_auto_show_time",
      "min": 0,
      "max": 180,
      "step": 5,
      "unit": "sec",
      "label": "Browse auto-show delay",
      "default": 60
    },
    {
      "type": "range",
      "id": "browse_auto_show_after_cart_time",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "sec",
      "label": "After add-to-cart auto-show delay",
      "default": 60
    },
    {
      "type": "range",
      "id": "frequency_cap",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "hr",
      "label": "Frequency cap",
      "default": 24
    },
    {
      "type": "number",
      "id": "frequency_cap_seconds",
      "label": "Frequency cap (seconds, dev override)",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "once_per_session",
      "label": "Show only once per session",
      "default": true
    },
    {
      "type": "range",
      "id": "order_suppression_days",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "day",
      "label": "Hide after completed order",
      "default": 7
    },
    {
      "type": "header",
      "content": "Page visibility"
    },
    {
      "type": "checkbox",
      "id": "disable_homepage",
      "label": "Disable on homepage",
      "default": false
    },
    {
      "type": "textarea",
      "id": "excluded_pages",
      "label": "Not displayed on other pages",
      "default": "/pages/trade-program-register\n/pages/business-opportunities"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading line 1",
      "default": "Your cart is waiting for you."
    },
    {
      "type": "text",
      "id": "heading_sub",
      "label": "Heading line 2",
      "default": "Time is ticking!"
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Promo banner title",
      "default": "25% off for your cart"
    },
    {
      "type": "text",
      "id": "expires_label",
      "label": "Expires prefix",
      "default": "Expires in"
    },
    {
      "type": "range",
      "id": "countdown_minutes",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "min",
      "label": "Countdown length",
      "default": 5
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading line 1 (empty cart)",
      "default": "Your cart is waiting for you."
    },
    {
      "type": "text",
      "id": "empty_heading_sub",
      "label": "Heading line 2 (empty cart)",
      "default": "Time is ticking!"
    },
    {
      "type": "range",
      "id": "max_cart_items",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Maximum items shown",
      "default": 5
    },
    {
      "type": "header",
      "content": "Klaviyo embed form"
    },
    {
      "type": "checkbox",
      "id": "klaviyo_replace_content",
      "label": "Use Klaviyo for email field only",
      "default": true
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder (fallback)",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "klaviyo_form_id",
      "label": "Klaviyo embed form ID",
      "default": "YaAhN2"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id_mobile",
      "label": "Klaviyo list ID (legacy fallback)",
      "default": "XDYfDR"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo list ID (fallback)"
    },
    {
      "type": "text",
      "id": "klaviyo_company_id",
      "label": "Klaviyo company ID (optional)"
    },
    {
      "type": "text",
      "id": "promo_code_filled",
      "label": "Promo code (cart has items)",
      "default": "MERRY25"
    },
    {
      "type": "text",
      "id": "promo_code_empty",
      "label": "Promo code (empty cart)",
      "default": "XMAS25"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SECURE MY CART"
    },
    {
      "type": "text",
      "id": "dismiss_label",
      "label": "Dismiss link label",
      "default": "Maybe Later"
    }
  ]
}
{% endschema %}
