{{ 'overlay-success-opt-in-mobile.css' | asset_url | stylesheet_tag }}
{{ 'overlay-success-opt-in-2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'overlay-success-opt-in.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign success_opt_in_promo_code = section.settings.heading_prefix | append: section.settings.heading_highlight | append: section.settings.heading_suffix | strip
  assign countdown_minutes = section.settings.countdown_minutes | default: 5
-%}

<success-opt-in-popup
  id="SuccessOptInMobile-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-device-target="mobile"
  data-variant="1"
  data-countdown-minutes="{{ countdown_minutes }}"
  data-default-link="{{ section.settings.button_link | default: '/checkout' }}"
  {% if success_opt_in_promo_code != blank %}
    data-promo-code="{{ success_opt_in_promo_code | escape }}"
  {% endif %}
>
  <div
    class="success-opt-in-popup success-opt-in-popup--xmas success-opt-in-popup--mobile{% if request.design_mode %} is-open{% endif %}"
    aria-hidden="{% if request.design_mode %}false{% else %}true{% endif %}"
  >
    <div class="success-opt-in-popup__overlay"></div>

    <div
      class="success-opt-in-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-label="{{ section.settings.eyebrow | default: success_opt_in_promo_code | escape }}"
    >
      <div class="success-opt-in-popup__media">
        {% render 'success-opt-in-hero', sizes: '100vw', alt: shop.name %}
        <button
          type="button"
          class="success-opt-in-popup__close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper" aria-hidden="true">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      <div class="success-opt-in-popup__panel">
        {%- if section.settings.eyebrow != blank -%}
          <p class="success-opt-in-popup__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {% render 'success-opt-in-promo-code' %}

        {%- if section.settings.disclaimer != blank -%}
          <p class="success-opt-in-popup__disclaimer">{{ section.settings.disclaimer | escape }}</p>
        {%- endif -%}

        <div class="success-opt-in-popup__timer">
          {%- if section.settings.hurry_label != blank -%}
            <p class="success-opt-in-popup__hurry">{{ section.settings.hurry_label | escape }}</p>
          {%- endif -%}
          <div class="success-opt-in-popup__countdown" data-success-opt-in-countdown aria-live="polite">
            <div class="success-opt-in-popup__cd-unit">
              <span class="success-opt-in-popup__cd-num" data-cd-h>00</span>
              <span class="success-opt-in-popup__cd-label">hours</span>
            </div>
            <span class="success-opt-in-popup__cd-sep" aria-hidden="true">:</span>
            <div class="success-opt-in-popup__cd-unit">
              <span class="success-opt-in-popup__cd-num" data-cd-m>05</span>
              <span class="success-opt-in-popup__cd-label">minutes</span>
            </div>
            <span class="success-opt-in-popup__cd-sep" aria-hidden="true">:</span>
            <div class="success-opt-in-popup__cd-unit">
              <span class="success-opt-in-popup__cd-num" data-cd-s>00</span>
              <span class="success-opt-in-popup__cd-label">seconds</span>
            </div>
          </div>
        </div>

        {%- if section.settings.button_label != blank -%}
          <button type="button" class="success-opt-in-popup__button" data-success-opt-in-cta>
            {{ section.settings.button_label | escape }}
          </button>
        {%- endif -%}

        {%- if section.settings.dismiss_label != blank -%}
          <button type="button" class="success-opt-in-popup__dismiss" data-success-opt-in-dismiss>
            {{ section.settings.dismiss_label | escape }}
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</success-opt-in-popup>

{% schema %}
{
  "name": "Success opt-in (mobile)",
  "tag": "section",
  "class": "overlay-section overlay-section--success-opt-in-mobile",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Optional. Leave blank to use the theme default gnome sofa hero."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Title",
      "default": "That's it. You're in!"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Promo code",
      "default": "MERRY25"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Promo code (middle)"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Promo code (end)"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "(*): This code can be combined with the current sale."
    },
    {
      "type": "text",
      "id": "hurry_label",
      "label": "Countdown intro",
      "default": "Hurry! Special offer ends in"
    },
    {
      "type": "range",
      "id": "countdown_minutes",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "min",
      "label": "Countdown length",
      "default": 5
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "CHECKOUT NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "dismiss_label",
      "label": "Secondary button",
      "default": "Back to Homepage"
    }
  ]
}
{% endschema %}
