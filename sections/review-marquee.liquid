{%- if section.settings.enabled -%}
{{ 'section-image-marquee.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ReviewMarquee-{{ section.id }} {
    --marquee-duration: {{ section.settings.scroll_speed }}s;
    --marquee-image-height: {{ section.settings.image_height }}px;
    --marquee-card-width: {{ section.settings.card_width }}px;
    --marquee-card-radius: {{ section.settings.card_radius }}px;
    --marquee-gap: {{ section.settings.image_gap }}px;
    --marquee-gap-mobile: {{ section.settings.image_gap | times: 0.75 | round: 0 }}px;
    --marquee-row-gap: {{ section.settings.row_gap }}px;
    --marquee-stagger: {{ section.settings.stagger_offset }}px;
  }
{%- endstyle -%}

<div
  class="image-marquee-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-review-marquee
  data-shop="{{ shop.permanent_domain }}"
  data-limit="{{ section.settings.reviews_to_show }}"
  hidden
>
  {%- if section.settings.title != blank or section.settings.description != blank -%}
    <div class="page-width image-marquee__header">
      {%- if section.settings.title != blank -%}
        <h2 class="image-marquee__heading title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="image-marquee__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="image-marquee-scroller" data-image-marquee data-autoscroll="true">
    <div
      id="ReviewMarquee-{{ section.id }}"
      class="image-marquee image-marquee--pause-on-hover image-marquee--double"
      role="region"
      aria-label="{{ section.settings.title | default: 'Recent reviews' | escape }}"
    >
      <div class="image-marquee__track">
        <div class="image-marquee__group image-marquee__group--double">
          <div class="image-marquee__rows">
            <div class="image-marquee__row image-marquee__row--top"></div>
            <div class="image-marquee__row image-marquee__row--bottom"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'image-marquee.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'review-marquee.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Review marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show review marquee",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "OUR HAPPY CUSTOMERS"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We pour so much care into every product we create, and nothing means more than seeing the joy they bring to families.</p>"
    },
    {
      "type": "range",
      "id": "reviews_to_show",
      "min": 4,
      "max": 20,
      "step": 1,
      "label": "Reviews to show",
      "default": 10
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Scroll duration",
      "default": 30
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Image height",
      "default": 180
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "label": "Card width",
      "default": 260
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Space between images",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Space between rows",
      "default": 16
    },
    {
      "type": "range",
      "id": "stagger_offset",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom row offset",
      "default": 130
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Review marquee"
    }
  ]
}
{% endschema %}
