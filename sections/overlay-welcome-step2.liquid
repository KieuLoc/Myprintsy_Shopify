{{ 'overlay-success-opt-in.css' | asset_url | stylesheet_tag }}
{{ 'overlay-welcome-step2.css' | asset_url | stylesheet_tag }}
{{ 'overlay-welcome-teaser.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="{{ 'overlay-welcome-step2.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign desktop_image = section.settings.image_desktop
  assign content_bg = section.settings.image_content_bg
  assign promo_code = section.settings.promo_code | strip
-%}

<welcome-step2-popup
  id="WelcomeStep2-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-device-target="desktop"
  data-default-link="{{ section.settings.button_link | default: '/collections/all' }}"
  data-countdown-hours="{{ section.settings.countdown_hours | default: 2 }}"
  {% if promo_code != blank %}
    data-promo-code="{{ promo_code | escape }}"
  {% endif %}
>
  <div
    class="success-opt-in-popup success-opt-in-popup--desktop welcome-step2{% if request.design_mode %} is-open{% endif %}"
    aria-hidden="{% if request.design_mode %}false{% else %}true{% endif %}"
    style="
      --welcome-step2-width: {{ section.settings.layout_width }}px;
      --welcome-step2-heading-color: {{ section.settings.color_heading }};
      --welcome-step2-text-color: {{ section.settings.color_text }};
      --welcome-step2-box-bg: {{ section.settings.color_box_bg }};
      --welcome-step2-box-border: {{ section.settings.color_box_border }};
      --welcome-step2-button-bg: {{ section.settings.color_button_bg }};
      --welcome-step2-button-text: {{ section.settings.color_button_text }};
      --welcome-step2-button-border: {{ section.settings.color_button_border }};
      --welcome-step2-link-color: {{ section.settings.color_link }};
    "
  >
    <div class="success-opt-in-popup__overlay"></div>

    <div
      class="success-opt-in-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-label="{{ section.settings.heading | escape }}"
      style="--success-opt-in-width: {{ section.settings.layout_width }}px;"
    >
      <button
        type="button"
        class="success-opt-in-popup__close"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>

      <div class="success-opt-in-popup__body">
        <div class="success-opt-in-popup__media">
          {%- if desktop_image != blank -%}
            {% render 'overlay-defer-image', image: desktop_image, alt: desktop_image.alt, default: section.settings.heading, max_width: 1200, widths: '550,750,900,1100,1200', sizes: '50vw' %}
          {%- else -%}
            <div class="success-opt-in-popup__media-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <div
          class="success-opt-in-popup__content welcome-step2__content{% if content_bg != blank %} welcome-step2__content--has-bg{% endif %}"
          {% if content_bg != blank %}
            data-myprintsy-defer-bg="{{ content_bg | image_url: width: 1200 }}"
          {% endif %}
        >
          <div class="welcome-step2__copy">
            {%- if section.settings.heading != blank -%}
              <h2 class="welcome-step2__heading">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}

            {%- if section.settings.info_text != blank -%}
              <div class="welcome-step2__info rte">{{ section.settings.info_text }}</div>
            {%- endif -%}

            {%- if section.settings.timer_label != blank -%}
              <p class="welcome-step2__timer-label">{{ section.settings.timer_label | escape }}</p>
            {%- endif -%}

            <div class="welcome-step2__timer-box" aria-live="polite">
              <span class="welcome-step2__timer" data-welcome-step2-countdown>02:00:00</span>
            </div>

            {%- if section.settings.help_text != blank -%}
              <p class="welcome-step2__help">{{ section.settings.help_text | escape }}</p>
            {%- endif -%}
          </div>

          <div class="welcome-step2__actions">
            {%- if section.settings.dismiss_label != blank -%}
              <a
                class="welcome-step2__button"
                href="{{ section.settings.dismiss_link | default: '/collections/all' }}"
              >
                {{ section.settings.dismiss_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  {% render 'welcome-teaser', device_target: 'desktop' %}
</welcome-step2-popup>

{% schema %}
{
  "name": "Welcome-Step2 (desktop)",
  "tag": "section",
  "class": "overlay-section overlay-section--welcome-step2-desktop",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "layout_width",
      "min": 700,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Layout width",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "image_content_bg",
      "label": "Right panel background"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to Myprintsy!"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Heading color",
      "default": "#1a3a5c"
    },
    {
      "type": "text",
      "id": "promo_code",
      "label": "Promo code (box 1)",
      "default": "MP15"
    },
    {
      "type": "richtext",
      "id": "info_text",
      "label": "Info text (under code)",
      "default": "<p>Applies to all order, including sale items.</p>"
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Timer label",
      "default": "This code expires in"
    },
    {
      "type": "range",
      "id": "countdown_hours",
      "min": 1,
      "max": 24,
      "step": 1,
      "unit": "h",
      "label": "Countdown duration",
      "default": 2,
      "info": "Starts when Welcome-Step2 first opens; persists in localStorage."
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Help text",
      "default": "If you missed it, check your email (including spam folder)!"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Body text color",
      "default": "#1a3a5c"
    },
    {
      "type": "color",
      "id": "color_box_bg",
      "label": "Box background",
      "default": "#fff8e8"
    },
    {
      "type": "color",
      "id": "color_box_border",
      "label": "Box border",
      "default": "#c4a35a"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button 1 label",
      "default": "SHOP BESTSELLER"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "SHOP TOP TRENDING"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "text",
      "id": "dismiss_label",
      "label": "Bottom link label",
      "default": "Browse All Deals"
    },
    {
      "type": "url",
      "id": "dismiss_link",
      "label": "Bottom link URL"
    },
    {
      "type": "color",
      "id": "color_button_bg",
      "label": "Button background",
      "default": "#1a3a5c"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_button_border",
      "label": "Button border accent",
      "default": "#9eb6d4"
    },
    {
      "type": "color",
      "id": "color_link",
      "label": "Bottom link color",
      "default": "#4a7ab0"
    },
    {
      "type": "header",
      "content": "Teaser (after close)"
    },
    {
      "type": "text",
      "id": "teaser_label",
      "label": "Teaser label",
      "default": "Extra 10% Off"
    },
    {
      "type": "color",
      "id": "teaser_bar_color",
      "label": "Teaser bar background",
      "default": "#1a3a5c"
    },
    {
      "type": "color",
      "id": "teaser_bar_text_color",
      "label": "Teaser bar text",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
