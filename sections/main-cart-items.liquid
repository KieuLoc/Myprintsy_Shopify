{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-macorner.css' | asset_url | stylesheet_tag }}
{{ 'component-quantity-macorner.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- assign has_gift_box_in_cart = false -%}
{%- for item in cart.items -%}
  {%- if item.properties._addon_gift_box != blank -%}
    {%- assign has_gift_box_in_cart = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_gift_box_in_cart -%}
  <script src="{{ 'addon-gift-box-pricing.js' | asset_url }}" defer="defer"></script>
  {% render 'gift-box-tier-variant-map' %}
  <script src="{{ 'cart-gift-box.js' | asset_url }}" defer="defer"></script>
  {% render 'gift-box-cart-image-source' %}
{%- endif -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-expiry-banner.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-preview-modal.js' | asset_url }}" defer="defer"></script>

<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate cart-page-macorner{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width cart-page-macorner__main">
    {%- unless cart == empty -%}
      {%- if section.settings.show_expiry_banner -%}
        <div
          class="cart-expiry-banner"
          data-cart-expiry-banner
          data-expiry-minutes="{{ section.settings.expiry_minutes }}"
          role="status"
          aria-live="polite"
        >
          {{ section.settings.expiry_banner_text }}
          <strong data-cart-expiry-timer>10:00</strong>
          {{ section.settings.expiry_banner_suffix }}
        </div>
      {%- endif -%}
    {%- endunless -%}

    <div class="title-wrapper-with-link">
      <h1 class="title title--primary cart-page-macorner__title">
        Shopping Cart ({{ cart.item_count }})
      </h1>
      <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <table class="cart-items">
              <caption class="visually-hidden">
                {{ 'sections.cart.title' | t }}
              </caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">
                    {{ 'sections.cart.headings.product' | t }}
                  </th>
                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                  <th
                    class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                    colspan="1"
                    scope="col"
                  >
                    {{ 'sections.cart.headings.quantity' | t }}
                  </th>
                  <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- assign _normal_rows = '' -%}
                {%- assign _addon_rows = '' -%}
                {%- for item in cart.items -%}
                  {%- assign _is_addon_gift_box = false -%}
                  {%- if item.properties != blank and item.properties._addon_gift_box != blank -%}
                    {%- assign _is_addon_gift_box = true -%}
                  {%- endif -%}
                  {%- assign _gift_box_tier_units = item.quantity -%}
                  {%- if _is_addon_gift_box and item.properties._gift_box_units != blank -%}
                    {%- assign _gift_box_tier_units = item.properties._gift_box_units -%}
                  {%- endif -%}
                  {%- assign _is_gift_box_bulk = false -%}
                  {%- if _is_addon_gift_box and item.properties._gift_box_bulk != blank -%}
                    {%- assign _is_gift_box_bulk = true -%}
                  {%- endif -%}
                  {%- assign _gift_box_mode = 'legacy' -%}
                  {%- if _is_addon_gift_box and item.properties._gift_box_mode == 'v2' -%}
                    {%- assign _gift_box_mode = 'v2' -%}
                  {%- endif -%}

                  {%- capture _row -%}
                  <tr
                    data-hulkapps-lineitem
                    class="cart-item"
                    id="CartItem-{{ item.index | plus: 1 }}"
                    data-line-key="{{ item.key }}"
                    {% if _is_addon_gift_box %}
                      data-addon-gift-box="true"
                      data-gift-box-units="{{ _gift_box_tier_units }}"
                      data-gift-box-mode="{{ _gift_box_mode }}"
                      {% if _is_gift_box_bulk %}data-gift-box-bulk="true"{% endif %}
                    {% endif %}
                  >
                    <td class="cart-item__media">
                      {%- if _is_addon_gift_box -%}
                        {%- liquid
                          assign _gb_thumb = item.image
                          if _gb_thumb == blank
                            assign _gb_thumb = gift_box_cart_display_image
                          endif
                        -%}
                        {%- if _gb_thumb != blank -%}
                          <div class="cart-macorner-media cart-macorner-media--gift-box">
                            <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                            <div class="cart-item__image-container gradient global-media-settings">
                              <img
                                src="{{ _gb_thumb | image_url: width: 600 }}"
                                class="cart-item__image"
                                alt="{{ _gb_thumb.alt | default: item.product.title | escape }}"
                                loading="lazy"
                                width="280"
                                height="280"
                              >
                            </div>
                          </div>
                        {%- endif -%}
                      {%- elsif item.image
                        or item.properties['_customily-preview'] != blank
                        or item.properties['_customily-thumb'] != blank
                      -%}
                        {%- liquid
                          assign cart_preview_src = blank
                          assign cart_thumb_src = blank

                          if item.properties['_customily-preview'] != blank
                            assign cart_preview_src = item.properties['_customily-preview']
                          elsif item.properties['_customily-thumb'] != blank
                            assign cart_preview_src = item.properties['_customily-thumb']
                          elsif item.image
                            assign cart_preview_src = item.image | image_url: width: 1400
                          endif

                          if item.properties['_customily-thumb'] != blank
                            assign cart_thumb_src = item.properties['_customily-thumb']
                          elsif item.properties['_customily-preview'] != blank
                            assign cart_thumb_src = item.properties['_customily-preview']
                          elsif item.image
                            assign cart_thumb_src = item.image | image_url: width: 600
                          endif

                          assign cart_preview_alt = item.product.title
                          if item.image.alt != blank
                            assign cart_preview_alt = item.image.alt
                          endif
                        -%}
                        {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                        <div class="cart-macorner-media">
                          <button
                            type="button"
                            class="cart-item__image-container gradient global-media-settings cart-macorner-media__preview-target"
                            data-cart-preview-trigger
                            data-preview-src="{{ cart_preview_src | escape }}"
                            data-preview-alt="{{ cart_preview_alt | escape }}"
                            aria-label="Preview {{ item.product.title | escape }}"
                          >
                            <img
                              src="{{ cart_thumb_src | escape }}"
                              class="cart-item__image"
                              alt="{{ cart_preview_alt | escape }}"
                              loading="lazy"
                              width="280"
                              height="280"
                            >
                          </button>
                          <button
                            type="button"
                            class="cart-macorner-preview-link"
                            data-cart-preview-trigger
                            data-preview-src="{{ cart_preview_src | escape }}"
                            data-preview-alt="{{ cart_preview_alt | escape }}"
                            aria-label="Preview {{ item.product.title | escape }}"
                          >
                            <span class="cart-macorner-preview-link__icon" aria-hidden="true">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                                <circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.75"/>
                                <path d="M10.5 7.75v5.5M7.75 10.5h5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                                <path d="M15.2 15.2L20 20" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                              </svg>
                            </span>
                            Preview
                          </button>
                        </div>
                      {%- endif -%}
                    </td>

                    <td class="cart-item__details">
                      {%- if settings.show_vendor -%}
                        <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                      {%- endif -%}

                      <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                      {%- if item.original_price != item.final_price -%}
                        <div class="cart-item__discounted-prices">
                          <span class="visually-hidden">
                            {{ 'products.product.price.regular_price' | t }}
                          </span>
                          <s  data-hulkapps-ci-price data-key='{{item.key}}' class="cart-item__old-price product-option">
                            {{- item.original_price | money -}}
                          </s>
                          <span class="visually-hidden">
                            {{ 'products.product.price.sale_price' | t }}
                          </span>
                          <strong  data-hulkapps-ci-price data-key='{{item.key}}' class="cart-item__final-price product-option"{% if _is_addon_gift_box %} data-gift-box-tier-price{% endif %}>
                            {{ item.final_price | money }}
                          </strong>
                        </div>
                      {%- else -%}
                        <div  data-hulkapps-ci-price data-key='{{item.key}}' class="product-option"{% if _is_addon_gift_box %} data-gift-box-tier-price{% endif %}>
                          {{ item.original_price | money }}
                        </div>
                      {%- endif -%}

                      {%- if item.product.has_only_default_variant == false
                        or item.properties.size != 0
                        or item.selling_plan_allocation != null
                      -%}
                        <dl>
                          {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                              <div class="product-option">
                                <dt>{{ option.name }}:</dt>
                                <dd>{{ option.value }}</dd>
                              </div>
                            {%- endfor -%}
                          {%- endif -%}

<div class='hulkapps-reminder' data-key='{{item.key}}'></div><span data-hulkapps-line-properties>
                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="product-option">
                                <dt>{{ property.first }}:</dt>
                                <dd>
                                  {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}" class="link" target="_blank">
                                      
{% assign file_type = property.last | split: '.' | last | downcase %}
{% assign file_types = 'jpg,jpeg,webp,gif,png,apng,avif,svg,bmp,ico,tiff' | split: ',' %}
{% if file_types contains file_type %}
  <div class="bcpo-cart-file"><img src="{{ property.last }}" style="max-width: 50px; height: auto;"></div>
{% else %}
  <span class="bcpo-cart-file">Uploaded file</span>
{% endif %}

                                    </a>
                                  {%- else -%}
                                    
{% if property.last contains '/uploads/' %}
	{% assign file_type = property.last | split: '.' | last | downcase %}
	{% assign file_types = 'jpg,jpeg,webp,gif,png,apng,avif,svg,bmp,ico,tiff' | split: ',' %}
	{% if file_types contains file_type %}
		<div class="bcpo-cart-file"><img src="{{ property.last }}" style="max-width: 50px; height: auto;"></div>
	{% else %}
		<span class="bcpo-cart-file">Uploaded file</span>
	{% endif %}
{% else %}
	{{ property.last }}
{% endif %}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
</span>
<button type='button' style='display: none;' class='edit_cart_option btn btn--primary button' data-product_id='{{item.product_id}}' data-key='{{item.key}}' data-variant_id='{{item.variant_id}}' data-quantity='{{item.quantity}}'>Edit Options</button>
                        </dl>

                        <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}

                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </td>

                    <td class="cart-item__totals right medium-hide large-up-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s  data-hulkapps-line-price data-key='{{item.key}}' class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd  data-hulkapps-line-price data-key='{{item.key}}' class="price price--end"{% if _is_addon_gift_box %} data-gift-box-tier-price{% endif %}>
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span  data-hulkapps-line-price data-key='{{item.key}}' class="price price--end"{% if _is_addon_gift_box %} data-gift-box-tier-price{% endif %}>
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          <div class="unit-price caption">
                            <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                            {{ item.unit_price | money }}
                            <span aria-hidden="true">/</span>
                            <span class="visually-hidden"
                              >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
                            >
                            {%- if item.unit_price_measurement.reference_value != 1 -%}
                              {{- item.unit_price_measurement.reference_value -}}
                            {%- endif -%}
                            {{ item.unit_price_measurement.reference_unit }}
                          </div>
                        {%- endif -%}
                      </div>
                    </td>
                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif

                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <td class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                aria-expanded="false"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                              >
                                {{- 'icon-info.svg' | inline_asset_content -}}
                              </button>
                            {%- endif -%}
                            <quantity-input class="quantity cart-quantity">
                              <button class="quantity__button" name="minus" type="button">
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-minus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <input
                                class="quantity__input"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                type="number"
                                name="updates[{{ item.key }}]"
                                value="{{ item.quantity }}"
                                {% if _is_addon_gift_box and _is_gift_box_bulk == false %}readonly{% endif %}
                                {% # theme-check-disable %}
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="0"
                                {% if _is_addon_gift_box %}
                                  data-min="1"
                                  step="1"
                                {% else %}
                                  data-min="{{ item.variant.quantity_rule.min }}"
                                  {% if item.variant.quantity_rule.max != null %}
                                    max="{{ item.variant.quantity_rule.max }}"
                                  {% endif %}
                                  step="{{ item.variant.quantity_rule.increment }}"
                                {% endif %}
                                {% # theme-check-enable %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Quantity-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                              <button class="quantity__button" name="plus" type="button">
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-plus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </quantity-input>
                          </div>
                          <cart-remove-button
                            id="Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                          >
                            <a
                              href="{{ item.url_to_remove }}"
                              class="button button--tertiary"
                              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-remove.svg' | inline_asset_content -}}
                              </span>
                            </a>
                          </cart-remove-button>
                        </div>
                        {%- if has_qty_rules or has_vol_pricing -%}
                          <button
                            type="button"
                            class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                            aria-expanded="false"
                          >
                            {{- 'icon-info.svg' | inline_asset_content -}}
                            <span>
                              {%- if has_vol_pricing -%}
                                {{ 'products.product.volume_pricing.note' | t }}
                              {%- elsif has_qty_rules -%}
                                {{ 'products.product.quantity.note' | t }}
                              {%- endif -%}
                            </span>
                          </button>
                        {%- endif -%}
                        {%- if has_vol_pricing or has_qty_rules -%}
                          <div
                            class="cart-items__info global-settings-popup quantity-popover__info"
                            tabindex="-1"
                            hidden
                          >
                            {%- if has_qty_rules == false -%}
                              <span class="volume-pricing-label caption">
                                {{- 'products.product.volume_pricing.title' | t -}}
                              </span>
                            {%- endif -%}
                            <div class="quantity__rules caption">
                              {%- if item.variant.quantity_rule.increment > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.multiples_of'
                                    | t: quantity: item.variant.quantity_rule.increment
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.min > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.min_of'
                                    | t: quantity: item.variant.quantity_rule.min
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.max != null -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.max_of'
                                    | t: quantity: item.variant.quantity_rule.max
                                  -}}
                                </span>
                              {%- endif -%}
                            </div>
                            <button
                              class="button-close button button--tertiary large-up-hide"
                              type="button"
                              aria-label="{{ 'accessibility.close' | t }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-close.svg' | inline_asset_content -}}
                              </span>
                            </button>
                            {%- if item.variant.quantity_price_breaks.size > 0 -%}
                              <volume-pricing class="parent-display">
                                <ul class="list-unstyled">
                                  <li>
                                    <span>{{ item.variant.quantity_rule.min }}+</span>
                                    {%- assign price = item.variant.price | money_with_currency -%}
                                    <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                  </li>
                                  {%- for price_break in item.variant.quantity_price_breaks -%}
                                    <li>
                                      <span>
                                        {{- price_break.minimum_quantity -}}
                                        <span aria-hidden="true">+</span></span
                                      >
                                      {%- assign price = price_break.price | money_with_currency -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </volume-pricing>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </quantity-popover>
                    </td>

                    <td class="cart-item__totals right small-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s  data-hulkapps-line-price data-key='{{item.key}}' class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd  data-hulkapps-line-price data-key='{{item.key}}' class="price price--end"{% if _is_addon_gift_box %} data-gift-box-tier-price{% endif %}>
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span  data-hulkapps-line-price data-key='{{item.key}}' class="price price--end"{% if _is_addon_gift_box %} data-gift-box-tier-price{% endif %}>
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          <div class="unit-price caption">
                            <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                            {{ item.unit_price | money }}
                            <span aria-hidden="true">/</span>
                            <span class="visually-hidden"
                              >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
                            >
                            {%- if item.unit_price_measurement.reference_value != 1 -%}
                              {{- item.unit_price_measurement.reference_value -}}
                            {%- endif -%}
                            {{ item.unit_price_measurement.reference_unit }}
                          </div>
                        {%- endif -%}
                      </div>
                    </td>
                  </tr>
                  {%- endcapture -%}

                  {%- if _is_addon_gift_box -%}
                    {%- assign _addon_rows = _addon_rows | append: _row -%}
                  {%- else -%}
                    {%- assign _normal_rows = _normal_rows | append: _row -%}
                  {%- endif -%}
                {%- endfor -%}

                {{ _normal_rows }}
                {{ _addon_rows }}
              </tbody>
            </table>
          {%- endif -%}
        </div>
      </div>
      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Macorner-style banner"
    },
    {
      "type": "checkbox",
      "id": "show_expiry_banner",
      "default": true,
      "label": "Show cart expiry countdown banner"
    },
    {
      "type": "range",
      "id": "expiry_minutes",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 10,
      "label": "Countdown duration (minutes)"
    },
    {
      "type": "text",
      "id": "expiry_banner_text",
      "default": "Your cart will expire in",
      "label": "Banner text before timer"
    },
    {
      "type": "text",
      "id": "expiry_banner_suffix",
      "default": "minutes! Check out now before your items sell out.",
      "label": "Banner text after timer"
    }
  ]
}
{% endschema %}