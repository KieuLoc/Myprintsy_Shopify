{%- comment -%}
  Product types in bmsm_types show the Buy More, Save More box.
  Other types render nothing — free-shipping line removed.
{%- endcomment -%}
{%- assign bmsm_types = 'cloak,ultra cloak,hoodie 3d,jogger,bomber jacket,zip hoodie,hawaii shirt,hawaiian shirt,socks,sock,sweatpant,sweatpants,legging,leggings' | split: ',' -%}
{%- assign fsc_type = product.type | strip | downcase -%}
{%- if bmsm_types contains fsc_type -%}
  {%- render 'special-coupon' -%}
{%- endif -%}
