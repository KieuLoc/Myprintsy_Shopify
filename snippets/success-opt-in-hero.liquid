{%- comment -%}
  Shared Success opt-in / opt-in 2 hero.
  Theme editor image_picker wins; otherwise fallback_asset (desktop reindeer / mobile gnome).
{%- endcomment -%}
{%- liquid
  assign hero_alt = alt | default: shop.name
  assign hero_sizes = sizes | default: '100vw'
  assign hero_fallback = fallback_asset | default: 'success-opt-in-gnome-sofa.jpg'
-%}
{%- if section.settings.image != blank -%}
  {{
    section.settings.image
    | image_url: width: 900
    | image_tag:
      class: 'success-opt-in-popup__hero',
      loading: 'lazy',
      widths: '375, 550, 750, 900',
      sizes: hero_sizes,
      alt: section.settings.image.alt | default: hero_alt
  }}
{%- else -%}
  <img
    class="success-opt-in-popup__hero"
    src="{{ hero_fallback | asset_url }}"
    alt="{{ hero_alt | escape }}"
    loading="lazy"
    width="900"
    height="900"
    sizes="{{ hero_sizes }}"
  >
{%- endif -%}
