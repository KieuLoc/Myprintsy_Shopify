<div
  class="welcome-teaser"
  data-welcome-teaser
  data-device-target="{{ device_target }}"
  hidden
  aria-hidden="true"
>
  <button
    type="button"
    class="welcome-teaser__dismiss"
    data-welcome-teaser-dismiss
    aria-label="{{ 'accessibility.close' | t }}"
  >
    <span aria-hidden="true">&times;</span>
  </button>
  <button
    type="button"
    class="welcome-teaser__open"
    data-welcome-teaser-open
    aria-label="Open welcome offer"
  >
    <span class="welcome-teaser__icon" aria-hidden="true">
      {%- if teaser_icon == 'christmas' -%}
      <svg class="welcome-teaser__gift" viewBox="0 0 64 64" width="48" height="48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="32" cy="56" rx="19" ry="3.5" fill="rgba(120, 20, 20, 0.15)"/>
        <path d="M14 30h36v21a3 3 0 0 1-3 3H17a3 3 0 0 1-3-3V30z" fill="url(#welcome-teaser-xbox-{{ device_target }})"/>
        <path d="M12 25h40v6a2 2 0 0 1-2 2H14a2 2 0 0 1-2-2v-6z" fill="url(#welcome-teaser-xlid-{{ device_target }})"/>
        <path d="M12 27c0-2 1.5-3 3.5-3h33c2 0 3.5 1 3.5 3-2 1.6-3.6.4-5 1.8-1.6-1.6-3.2.6-5-.6-1.8 1.4-3.6-.6-5.4.8-1.8-1.4-3.6.6-5.4-.8-1.8 1.2-3.4-1-5.2.6-1.6-1.2-3.4.6-5-.6-1.4 1-2.8.2-4-.2z" fill="#ffffff"/>
        <path d="M32 25v29" stroke="url(#welcome-teaser-xribbon-{{ device_target }})" stroke-width="5"/>
        <path d="M14 41h36" stroke="url(#welcome-teaser-xribbon-{{ device_target }})" stroke-width="4"/>
        <path d="M32 24c-6-.5-11-3-11.5-7-.3-2.6 2.6-3.6 5-2.2 3 1.8 5.4 5 6.5 9.2z" fill="#d4af37" stroke="#b08a1e" stroke-width="1"/>
        <path d="M32 24c6-.5 11-3 11.5-7 .3-2.6-2.6-3.6-5-2.2-3 1.8-5.4 5-6.5 9.2z" fill="#d4af37" stroke="#b08a1e" stroke-width="1"/>
        <path d="M30 24l-4 7M34 24l4 7" stroke="#d4af37" stroke-width="2.4" stroke-linecap="round"/>
        <circle cx="32" cy="23.5" r="2.6" fill="#f3d36b" stroke="#b08a1e" stroke-width="1"/>
        <path d="M19 47c1.5-3.6 5-4.6 7.6-3.4-1 3.2-4.4 5-7.6 3.4z" fill="#1f7a3a"/>
        <path d="M19 47c-3.6-1.4-4.6-5-3.4-7.6 3.2 1 5 4.4 3.4 7.6z" fill="#2e9a4d"/>
        <circle cx="19.6" cy="46" r="1.6" fill="#ff3b3b"/>
        <circle cx="21.6" cy="47.6" r="1.4" fill="#e01e1e"/>
        <path d="M8 12v6M5 15h6M6 13l4 4M10 13l-4 4" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" opacity=".9"/>
        <path d="M55 6v5M52.5 8.5h5" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" opacity=".85"/>
        <circle cx="50" cy="16" r="1.2" fill="#ffffff" opacity=".85"/>
        <defs>
          <linearGradient id="welcome-teaser-xbox-{{ device_target }}" x1="14" y1="30" x2="50" y2="54" gradientUnits="userSpaceOnUse">
            <stop stop-color="#e3262e"/>
            <stop offset="1" stop-color="#a5121a"/>
          </linearGradient>
          <linearGradient id="welcome-teaser-xlid-{{ device_target }}" x1="12" y1="25" x2="52" y2="33" gradientUnits="userSpaceOnUse">
            <stop stop-color="#f03a40"/>
            <stop offset="1" stop-color="#c11d24"/>
          </linearGradient>
          <linearGradient id="welcome-teaser-xribbon-{{ device_target }}" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
            <stop stop-color="#f3d36b"/>
            <stop offset="1" stop-color="#c49a2a"/>
          </linearGradient>
        </defs>
      </svg>
      {%- else -%}
      <svg class="welcome-teaser__gift" viewBox="0 0 64 64" width="48" height="48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="32" cy="54" rx="18" ry="4" fill="rgba(26, 58, 92, 0.12)"/>
        <path d="M14 28h36v22a3 3 0 0 1-3 3H17a3 3 0 0 1-3-3V28z" fill="url(#welcome-teaser-box-{{ device_target }})"/>
        <path d="M12 24h40v6a2 2 0 0 1-2 2H14a2 2 0 0 1-2-2v-6z" fill="url(#welcome-teaser-lid-{{ device_target }})"/>
        <path d="M30 24v29" stroke="#c4a35a" stroke-width="3" stroke-linecap="round"/>
        <path d="M14 31h36" stroke="#c4a35a" stroke-width="3" stroke-linecap="round"/>
        <path d="M32 24V14" stroke="#c4a35a" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M32 14c-4.5 0-7.5-2.2-8.5-5.2 2.8-.8 5.5.2 8.5 3.2 3-3 5.7-4 8.5-3.2C39.5 11.8 36.5 14 32 14z" fill="url(#welcome-teaser-bow-{{ device_target }})"/>
        <path d="M24.5 12.5c-2.2 1.2-3.5 3-3.8 5.1-.1.8.5 1.4 1.2 1.1 2.1-.9 3.8-2.6 5-4.8-1-.6-1.8-1-2.4-1.4z" fill="#e8c872"/>
        <path d="M39.5 12.5c2.2 1.2 3.5 3 3.8 5.1.1.8-.5 1.4-1.2 1.1-2.1-.9-3.8-2.6-5-4.8 1-.6 1.8-1 2.4-1.4z" fill="#e8c872"/>
        <circle cx="32" cy="14.5" r="2.2" fill="#f5dfa0" stroke="#c4a35a" stroke-width="1"/>
        <defs>
          <linearGradient id="welcome-teaser-box-{{ device_target }}" x1="14" y1="28" x2="50" y2="53" gradientUnits="userSpaceOnUse">
            <stop stop-color="#234a72"/>
            <stop offset="1" stop-color="#1a3a5c"/>
          </linearGradient>
          <linearGradient id="welcome-teaser-lid-{{ device_target }}" x1="12" y1="24" x2="52" y2="32" gradientUnits="userSpaceOnUse">
            <stop stop-color="#2a5580"/>
            <stop offset="1" stop-color="#1f4266"/>
          </linearGradient>
          <linearGradient id="welcome-teaser-bow-{{ device_target }}" x1="23" y1="8" x2="41" y2="18" gradientUnits="userSpaceOnUse">
            <stop stop-color="#d4b76a"/>
            <stop offset="1" stop-color="#c4a35a"/>
          </linearGradient>
        </defs>
      </svg>
      {%- endif -%}
    </span>
  </button>
</div>
