{%- comment -%}
  Buy More, Save More — volume discount callout under PDP price.
  Display only; discounts still apply via Shopify automatic discounts on cart.
{%- endcomment -%}
<style>
  .bmsm {
    margin: 0.8rem 0 0;
    padding: 1.4rem 1.6rem 1.2rem;
    background: #f7f3ef;
    border-radius: 1rem;
  }
  /* Ghi đè .product__info-container > * + * { margin: 1.5rem } — gap 8px tới Delivered-to */
  .product__info-container > .bmsm {
    margin: 0.8rem 0 8px !important;
  }
  .bmsm__title {
    margin: 0 0 0.9rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.01rem;
    color: #1a1a1a;
    line-height: 1.3;
  }
  .bmsm__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 2.2rem max-content max-content;
    column-gap: 0.5rem;
    row-gap: 0.55rem;
    align-items: center;
  }
  .bmsm__row {
    display: contents;
  }
  .bmsm__icon {
    width: 2.2rem;
    height: 2.2rem;
    display: block;
    color: #e67a12;
  }
  .bmsm__qty {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.3;
    white-space: nowrap;
  }
  .bmsm__off {
    font-size: 1.4rem;
    font-weight: 500;
    color: #e67a12;
    line-height: 1.3;
  }
  .bmsm__note {
    margin: 0.9rem 0 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.01rem;
    color: #8a8a8a;
    line-height: 1.3;
  }
</style>
<div class="bmsm" aria-label="Buy More, Save More">
  <p class="bmsm__title">Buy More, Save More</p>
  <ul class="bmsm__list">
    <li class="bmsm__row">
      <svg class="bmsm__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="4" y="10" width="16" height="11" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M4 14h16M12 10v11" stroke="currentColor" stroke-width="1.8"/>
        <path d="M12 10c-2.2-3.5-5.5-3.2-5.5-.8C6.5 11.2 9 12.2 12 10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        <path d="M12 10c2.2-3.5 5.5-3.2 5.5-.8C17.5 11.2 15 12.2 12 10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      </svg>
      <span class="bmsm__qty">Buy 2</span>
      <span class="bmsm__off">Get 10% Off</span>
    </li>
    <li class="bmsm__row">
      <svg class="bmsm__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="4" y="10" width="16" height="11" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M4 14h16M12 10v11" stroke="currentColor" stroke-width="1.8"/>
        <path d="M12 10c-2.2-3.5-5.5-3.2-5.5-.8C6.5 11.2 9 12.2 12 10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        <path d="M12 10c2.2-3.5 5.5-3.2 5.5-.8C17.5 11.2 15 12.2 12 10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      </svg>
      <span class="bmsm__qty">Buy 3</span>
      <span class="bmsm__off">Get 15% Off</span>
    </li>
    <li class="bmsm__row">
      <svg class="bmsm__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="4" y="10" width="16" height="11" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M4 14h16M12 10v11" stroke="currentColor" stroke-width="1.8"/>
        <path d="M12 10c-2.2-3.5-5.5-3.2-5.5-.8C6.5 11.2 9 12.2 12 10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        <path d="M12 10c2.2-3.5 5.5-3.2 5.5-.8C17.5 11.2 15 12.2 12 10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      </svg>
      <span class="bmsm__qty">Buy 4+</span>
      <span class="bmsm__off">Get 20% Off</span>
    </li>
  </ul>
  <p class="bmsm__note">Auto apply discounts on Cart Page</p>
</div>
